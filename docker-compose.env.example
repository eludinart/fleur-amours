# Config Docker Compose — Fleur d'AmOurs (VPS = source unique)
# Copier en docker-compose.env et remplir.
# NE PAS COMMITTER docker-compose.env
#
# Usage:
#   1. Si MariaDB vide : npm run sync:db (config sync-config.env)
#   2. docker compose --env-file docker-compose.env up -d

# --- Base de données (MariaDB) ---
# Local (docker-compose.next.local.yml) : MARIADB_HOST=mariadb (service du compose)
# Coolify : MARIADB_HOST = hostname de la ressource MariaDB (voir sync-config.env LOCAL_HOST)
MARIADB_HOST=mariadb
DB_NAME=default
DB_USER=mariadb
DB_PASSWORD=

# Préfixe des tables WordPress
DB_PREFIX=wp_

# Pool MariaDB (Next.js) — évite « Queue limit reached » sous charge
# MARIADB_POOL_LIMIT=10
# MARIADB_POOL_QUEUE_LIMIT=50
# MARIADB_POOL_IDLE_TIMEOUT_MS=60000

# --- JWT ---
JWT_SECRET=

# --- URLs ---
APP_PUBLIC_URL=https://app-fleurdamours.eludein.art/jardin

# --- IA (OpenRouter ou Mistral) ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=  # optionnel, défaut: google/gemini-2.5-flash-lite
MISTRAL_API_KEY=
# MISTRAL_MODEL=  # optionnel, défaut: mistral-small-latest

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=   # Price ID abonnement mensuel (price_...)
STRIPE_PRICE_YEARLY=    # Price ID abonnement annuel (price_...)
STRIPE_PRICE_CREDITS_100=  # Price ID pack 100 crédits (price_...)

# --- SMTP (e-mails transactionnels : invitations, contact, notifications) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fleur d'AmOurs <noreply@votredomaine.com>"
SMTP_REPLY_TO=contact@votredomaine.com

# --- Optionnel ---
JWT_EXPIRE_HOURS=720

# --- Cron Coolify (relances engagement, plan 14j, check-in…) ---
# Générer une valeur longue aléatoire ; identique dans Scheduled Task (header x-cron-secret).
CRON_SECRET=
# En prod : false (envois à tous les utilisateurs éligibles). En dev/staging : true limite à eludinart@gmail.com
NOTIFICATIONS_DEV_ONLY=false
