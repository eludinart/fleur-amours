# Copier vers .env.smoke (non versionné) pour tests smoke / e2e / post-deploy.
# Ne jamais committer de vrais mots de passe.

# URL cible (local ou prod)
SMOKE_BASE_URL=http://127.0.0.1:3001/jardin
# SMOKE_BASE_URL=https://app-fleurdamours.eludein.art/jardin

# Compte test dédié (recommandé : utilisateur non-admin, profil public)
SMOKE_EMAIL=
SMOKE_PASSWORD=

# Ou token JWT existant (alternative au login)
# SMOKE_TOKEN=

# User ID pour tester visit_lisiere (optionnel)
# SMOKE_VISIT_USER_ID=

# En prod : exiger DB connectée + IA (OpenRouter ou Mistral selon admin)
# SMOKE_STRICT=1

# Réutiliser la DB locale (dev.vps / docker)
# MARIADB_HOST=127.0.0.1
# MARIADB_PORT=3307
# MARIADB_DATABASE=
# MARIADB_USER=
# MARIADB_PASSWORD=
# JWT_SECRET=
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
